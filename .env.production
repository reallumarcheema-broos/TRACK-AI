# Public settings for production builds (npm run build, Vercel and Docker).
# This file is committed to the public repository: put ONLY public values here, never API keys or
# passwords (those go in Vercel → Settings → Environment Variables). A value set in Vercel's
# environment variables overrides the one here. Empty means off.

# Your Google AdSense publisher id (AdSense → Account → Account information), e.g. ca-pub-1234567890123456
VITE_ADSENSE_CLIENT=
# A responsive display ad unit's id (AdSense → Ads → By ad unit → Display ads), e.g. 9876543210
VITE_ADSENSE_SLOT=
# Google Search Console's "HTML tag" code: just the content="…" value.
GOOGLE_SITE_VERIFICATION=
# The address shown on the contact page (the page only exists when this is set).
VITE_CONTACT_EMAIL=
# The site's address for the sitemap and canonical links. Leave empty on Vercel: it uses the
# production domain (your own domain once it's connected).
SITE_URL=
