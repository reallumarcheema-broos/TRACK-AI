# Server (npm start / Docker) ---------------------------------------------------------------
# Enables the AI debrief after each set. Any credential the Anthropic SDK accepts works.
ANTHROPIC_API_KEY=
# Claude model used for debriefs.
COACH_MODEL=claude-opus-5
PORT=8787
# Only needed when the frontend is hosted on a different origin (e.g. GitHub Pages):
# ALLOWED_ORIGINS=https://you.github.io
# DEBRIEFS_PER_MINUTE=12

# Frontend build (npm run build) ------------------------------------------------------------
# Where the debrief API lives when it isn't on the same origin as the app.
# VITE_COACH_API_URL=https://track-ai.example.com
# Hosting without the server (e.g. GitHub Pages)? Turn the AI debrief off: every set then gets the
# on-device summary and the option is hidden.
# VITE_AI_DEBRIEF=off

# Paid plan (Lemon Squeezy): 3 free workouts, then a subscription. Leave these unset for a free app.
# The subscription's checkout link (build time). Turns the paywall on.
# VITE_CHECKOUT_URL=https://yourstore.lemonsqueezy.com/buy/00000000-0000-0000-0000-000000000000
# The price shown in the app (the real price is set in Lemon Squeezy).
# VITE_PRICE=$14.99
# The store and product whose license keys unlock the app (server / Vercel function).
# LEMONSQUEEZY_STORE_ID=12345
# LEMONSQUEEZY_PRODUCT_ID=67890

# Optional: App Store / Google Play listings. When set, the "Install on iPhone/Android" buttons link
# there instead of installing the web app.
# VITE_APP_STORE_URL=https://apps.apple.com/app/id0000000000
# VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.example.trackai
