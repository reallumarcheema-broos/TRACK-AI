# Server (npm start / Docker) ---------------------------------------------------------------
# Enables the AI debrief after each set. Any credential the Anthropic SDK accepts works.
ANTHROPIC_API_KEY=
# Claude model used for debriefs.
COACH_MODEL=claude-opus-5
PORT=8787
# Only needed when the frontend is hosted on a different origin (e.g. GitHub Pages):
# ALLOWED_ORIGINS=https://you.github.io
# DEBRIEFS_PER_MINUTE=12

# Frontend build (npm run build) ------------------------------------------------------------
# Where the debrief API lives when it isn't on the same origin as the app.
# VITE_COACH_API_URL=https://track-ai.example.com
# Hosting without the server (e.g. GitHub Pages)? Turn the AI debrief off: every set then gets the
# on-device summary and the option is hidden.
# VITE_AI_DEBRIEF=off

# Ads and the website pages (see README → Ads). The live values are in .env.production, which is
# committed because they're all public; set them here only to try them locally.
# Your Google AdSense publisher id.
# VITE_ADSENSE_CLIENT=ca-pub-1234567890123456
# A responsive display ad unit's id (AdSense → Ads → By ad unit → Display ads).
# VITE_ADSENSE_SLOT=9876543210
# Google Search Console's "HTML tag" code (just the content value).
# GOOGLE_SITE_VERIFICATION=abc123XYZ-_abc123XYZ
# The site's address, for the sitemap and canonical links (Vercel's production address when unset).
# SITE_URL=https://trackai.fit
# Adds the contact page.
# VITE_CONTACT_EMAIL=hello@trackai.fit
