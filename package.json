{
  "name": "track-ai-coach",
  "private": true,
  "version": "0.1.0",
  "description": "AI personal trainer in your browser: real-time body tracking, rep counting, form correction and voice coaching.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && tsx scripts/build-site.ts",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fetch-models": "node scripts/fetch-models.mjs",
    "people": "tsx scripts/generate-people.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
